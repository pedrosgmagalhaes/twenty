# ── Twenty CRM Dockerfile (wrapper) ──────────────────────────────────
# Usa a imagem oficial do Twenty como base
# Roda migrações antes de iniciar o servidor

FROM twentycrm/twenty:latest

LABEL maintainer="10ContoAI"
LABEL description="Twenty CRM - Deploy via fork (migrations auto)"

ENV NODE_ENV=production
ENV SERVER_PORT=3000

# Roda migrações do banco antes de iniciar o servidor
# O entrypoint oficial do Twenty já faz isso, mas garantimos
CMD ["sh", "-c", "yarn command:workspace:run database:migrate:prod && yarn start:prod"]
